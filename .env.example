# Copy to .env and fill in when Supabase / Redis are ready.
# Phase 1 runs without these (homepage + health check only).

# Public (safe for browser)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_APP_ORIGIN=http://localhost:5173

# Server-only (never expose to client). Powers server-side public flows
# (join page, typeahead, submissions) which RLS deliberately blocks for anon.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Server-only: signs short-lived QR attendance tokens (HMAC).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local dev works without it (per-boot secret), production must set a stable one.
APP_SECRET=

# Server-only: Google Sheets export (Phase: results).
# Service-account JSON (keep secret — never expose to the client).
# The sheet must be shared with the service-account email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Default spreadsheet when the host leaves the field blank.
GOOGLE_SHEET_ID=

# adapter-node
PORT=3000
ORIGIN=http://localhost:3000
